# Ambiente: local | development | production
ENVIRONMENT=local

# URLs da API
# local: localhost | development: IP da máquina na rede | production: domínio HTTPS
API_BASE_URL=http://localhost:3000
TECAAI_BASE_URL=http://localhost:5001
UPLOADS_BASE_URL=http://localhost:3000

# Exemplo para celular na mesma rede Wi-Fi:
# ENVIRONMENT=development
# API_BASE_URL=http://192.168.0.10:3000
# TECAAI_BASE_URL=http://192.168.0.10:5001
# UPLOADS_BASE_URL=http://192.168.0.10:3000
# No Android, adicione o IP em android/app/src/main/res/xml/network_security_config.xml

# Timeouts (segundos)
API_REQUEST_TIMEOUT=30
TECAAI_REQUEST_TIMEOUT=30

# Tamanho máximo de upload (bytes) — 10MB
MAX_FILE_SIZE=10485760

# Rede
ENABLE_HTTPS=false
ENABLE_CORS=true

# Debug
DEBUG_MODE=true
LOG_LEVEL=verbose
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false
