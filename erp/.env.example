# ByLAB ERP — Flutter (mobile/web)
# Copie: cp .env.example .env

# --- Local (Docker API na máquina) ---
ENVIRONMENT=local
API_BASE_URL=http://localhost:3150
UPLOADS_BASE_URL=http://localhost:3150
TECAAI_BASE_URL=http://localhost:5010
TECA_ERP_BASE_URL=https://teca.exemplo.com/erp
ALEXANDRIA_API_URL=https://painel.exemplo.com/api.php
ENABLE_HTTPS=false
DEBUG_MODE=true
LOG_LEVEL=verbose

API_REQUEST_TIMEOUT=30
TECAAI_REQUEST_TIMEOUT=30
TECA_ERP_REQUEST_TIMEOUT=15
MAX_FILE_SIZE=10485760
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false

# --- Produção VPS (IP + porta) ---
# ENVIRONMENT=production
# API_BASE_URL=http://SEU_IP_OU_DOMINIO:3150
# UPLOADS_BASE_URL=http://SEU_IP_OU_DOMINIO:3150
# TECAAI_BASE_URL=http://SEU_IP_OU_DOMINIO:5010
# TECA_ERP_BASE_URL=https://teca.exemplo.com/erp
# ALEXANDRIA_API_URL=https://painel.exemplo.com/api.php
# ENABLE_HTTPS=false
# DEBUG_MODE=false
# LOG_LEVEL=error
