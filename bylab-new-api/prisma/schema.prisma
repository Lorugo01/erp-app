generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  password         String
  role             Role
  createdAt        DateTime          @default(now())
  photoUrl         String?
  student          Student?
  teacher          Teacher?
  chatParticipants chatparticipant[]
  messages         message[]
}

model Student {
  id                    String                 @id @default(uuid())
  name                  String
  email                 String                 @unique
  createdAt             DateTime               @default(now())
  profilePicture        String?
  registrationNumber    String?                @unique
  userId                String?                @unique
  address               String?
  birthDate             DateTime?
  phone                 String?
  assignmentSubmissions AssignmentSubmission[]
  attendances           Attendance[]
  enrollments           Enrollment[]
  grades                Grade[]
  user                  User?                  @relation(fields: [userId], references: [id])
}

model chat {
  id           String            @id @default(uuid())
  title        String
  created_at   DateTime          @default(now())
  participants chatparticipant[]
  messages     message[]
}

model chatparticipant {
  id      String @id @default(uuid())
  chat_id String
  user_id String
  chat    chat   @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model message {
  id         String   @id @default(uuid())
  chat_id    String
  user_id    String?
  content    String
  created_at DateTime @default(now())
  personagem String?
  files      File[]
  chat       chat     @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model File {
  id          String   @id @default(uuid())
  message_id  String
  file_path   String
  file_name   String
  file_type   String
  uploaded_at DateTime @default(now())
  message     message  @relation(fields: [message_id], references: [id], onDelete: Cascade)
}

model Enrollment {
  id        String  @id @default(uuid())
  studentId String
  classId   String
  year      Int
  current   Boolean @default(false)
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId, year])
}

model Class {
  id              String       @id @default(uuid())
  name            String
  grade           Int
  academicYear    Int
  shift           Shift
  letter          String
  evaluationModel String
  assignments     Assignment[]
  enrollments     Enrollment[]
  events          Event[]
  lessons         Lesson[]
  subjects        Subject[]
}

model Teacher {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  createdAt DateTime  @default(now())
  userId    String?   @unique
  photoUrl  String?
  events    Event[]   @relation("TeacherToEvent")
  lessons   Lesson[]
  subjects  Subject[]
  user      User?     @relation(fields: [userId], references: [id])
}

model Subject {
  id          String       @id @default(uuid())
  name        String
  classId     String
  teacherId   String
  createdAt   DateTime     @default(now())
  type        SubjectType
  updatedAt   DateTime     @updatedAt
  assignments Assignment[]
  grades      Grade[]
  lessons     Lesson[]
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher     Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model Lesson {
  id          String       @id @default(uuid())
  date        DateTime
  subjectId   String
  classId     String
  teacherId   String
  attendances Attendance[]
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher     Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model Attendance {
  id           String          @id @default(uuid())
  studentId    String
  lessonId     String
  status       AttendanceStatus @default(PRESENT)
  justification String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  lesson       Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student      Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  // Manter compatibilidade com o campo antigo
  present      Boolean         @default(true)
}

model GradePeriod {
  id     String  @id @default(uuid())
  name   String
  order  Int
  grades Grade[]
}

model GradeType {
  id          String  @id @default(uuid())
  name        String
  description String?
  isConcept   Boolean @default(false)
  grades      Grade[]
}

model Grade {
  id        String      @id @default(uuid())
  studentId String
  subjectId String
  typeId    String
  value     Float?
  date      DateTime    @default(now())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  concept   String?
  periodId  String
  period    GradePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  student   Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  type      GradeType   @relation(fields: [typeId], references: [id], onDelete: Cascade)
}

model Config {
  id              Int    @id @default(1)
  evaluationModel String
  minGrade        Float  @default(5.0)
  minAttendance   Float  @default(75.0)
}

model Event {
  id          String    @id @default(uuid())
  classId     String
  title       String
  description String?
  dayOfWeek   Int?
  startTime   String?
  endTime     String?
  date        DateTime?
  createdAt   DateTime  @default(now())
  teacherId   String
  class       Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher     Teacher   @relation("TeacherToEvent", fields: [teacherId], references: [id])
}

model Assignment {
  id          String                 @id @default(uuid())
  classId     String
  description String
  dueDate     DateTime
  sentDate    DateTime               @default(now())
  fileUrl     String?
  createdAt   DateTime               @default(now())
  subjectId   String
  class       Class                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject                @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String     @id @default(uuid())
  assignmentId String
  studentId    String
  fileUrl      String?
  description  String?
  submittedAt  DateTime   @default(now())
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

enum Role {
  ADMIN
  STUDENT
  TEACHER
}

enum Shift {
  MATUTINO
  VESPERTINO
  NOTURNO
  INTEGRAL
}

enum SubjectType {
  LINGUA_INGLESA
  ARTE
  EDUCACAO_FISICA
  MATEMATICA
  CIENCIAS
  HISTORIA
  GEOGRAFIA
  ENSINO_RELIGIOSO
  BIOLOGIA
  FISICA
  QUIMICA
  FILOSOFIA
  SOCIOLOGIA
  CONTEUDO_INTERDISCIPLINAR
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  JUSTIFIED_ABSENT
}
