generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id          String   @id @default(uuid())
  name        String
  address     String?
  phone       String?
  email       String?
  website     String?
  logo        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relacionamentos
  users           User[]
  students        Student[]
  teachers        Teacher[]
  classes         Class[]
  subjects        Subject[]
  schoolSubjects  SchoolSubject[]
  events          Event[]
  chats           chat[]
  configs         Config[]
  gradePeriods    GradePeriod[]
  gradeTypes      GradeType[]
  
  @@map("schools")
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  password         String
  role             Role
  createdAt        DateTime          @default(now())
  photoUrl         String?
  schoolId         String?
  student          Student?
  teacher          Teacher?
  chatParticipants chatparticipant[]
  messages         message[]
  
  // Relacionamentos
  school           School?           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  @@unique([email, schoolId])
}

model Student {
  id                    String                 @id @default(uuid())
  name                  String
  email                 String
  createdAt             DateTime               @default(now())
  profilePicture        String?
  registrationNumber    String?
  userId                String?                @unique
  address               String?
  birthDate             DateTime?
  phone                 String?
  schoolId              String
  assignmentSubmissions AssignmentSubmission[]
  attendances           Attendance[]
  enrollments           Enrollment[]
  grades                Grade[]
  
  // Relacionamentos
  user                  User?                  @relation(fields: [userId], references: [id])
  school                School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  @@unique([email, schoolId])
  @@unique([registrationNumber, schoolId])
}

model chat {
  id           String            @id @default(uuid())
  title        String
  created_at   DateTime          @default(now())
  schoolId     String
  participants chatparticipant[]
  messages     message[]
  
  // Relacionamentos
  school       School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model chatparticipant {
  id      String @id @default(uuid())
  chat_id String
  user_id String
  chat    chat   @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model message {
  id         String   @id @default(uuid())
  chat_id    String
  user_id    String?
  content    String
  created_at DateTime @default(now())
  personagem String?
  files      File[]
  chat       chat     @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model File {
  id          String   @id @default(uuid())
  message_id  String
  file_path   String
  file_name   String
  file_type   String
  uploaded_at DateTime @default(now())
  message     message  @relation(fields: [message_id], references: [id], onDelete: Cascade)
}

model Enrollment {
  id        String  @id @default(uuid())
  studentId String
  classId   String
  year      Int
  current   Boolean @default(false)
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId, year])
}

model Class {
  id              String       @id @default(uuid())
  name            String
  grade           Int
  academicYear    Int
  shift           Shift
  letter          String
  evaluationModel String
  assignments     Assignment[]
  enrollments     Enrollment[]
  events          Event[]
  lessons         Lesson[]
  subjects        Subject[]
  schoolId        String
  
  // Relacionamentos
  school          School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model Teacher {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  createdAt DateTime  @default(now())
  userId    String?   @unique
  photoUrl  String?
  events    Event[]   @relation("TeacherToEvent")
  lessons   Lesson[]
  subjects  Subject[]
  user      User?     @relation(fields: [userId], references: [id])
  schoolId  String
  
  // Relacionamentos
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model SchoolSubject {
  id          String      @id @default(uuid())
  name        String
  description String?
  type        SubjectType
  schoolId    String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  school      School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  offerings   Subject[]

  @@unique([schoolId, type])
  @@map("school_subjects")
}

model Subject {
  id              String         @id @default(uuid())
  name            String
  classId         String
  teacherId       String
  createdAt       DateTime       @default(now())
  type            SubjectType
  updatedAt       DateTime       @updatedAt
  schoolSubjectId String?
  assignments     Assignment[]
  grades          Grade[]
  lessons         Lesson[]
  class           Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher         Teacher        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  schoolId        String
  school          School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolSubject   SchoolSubject? @relation(fields: [schoolSubjectId], references: [id], onDelete: SetNull)

  @@unique([classId, type])
}

model Lesson {
  id          String       @id @default(uuid())
  date        DateTime
  subjectId   String
  classId     String
  teacherId   String
  attendances Attendance[]
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher     Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model Attendance {
  id            String           @id @default(uuid())
  studentId     String
  lessonId      String
  present       Boolean          @default(true)
  createdAt     DateTime         @default(now())
  justification String?
  status        AttendanceStatus @default(PRESENT)
  updatedAt     DateTime         @updatedAt
  lesson        Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student       Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model GradePeriod {
  id       String  @id @default(uuid())
  name     String
  order    Int
  schoolId String
  grades   Grade[]
  
  // Relacionamentos
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model GradeType {
  id          String  @id @default(uuid())
  name        String
  description String?
  isConcept   Boolean @default(false)
  isRecovery  Boolean @default(false)
  schoolId    String
  grades      Grade[]

  // Relacionamentos
  school      School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model Grade {
  id        String      @id @default(uuid())
  studentId String
  subjectId String
  typeId    String
  value     Float?
  date      DateTime    @default(now())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  concept   String?
  periodId  String
  period    GradePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  student   Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  type      GradeType   @relation(fields: [typeId], references: [id], onDelete: Cascade)
}

model Config {
  id              String @id @default(uuid())
  evaluationModel String
  minGrade        Float  @default(5.0)
  minAttendance   Float  @default(75.0)
  schoolId        String
  
  // Relacionamentos
  school          School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  @@unique([schoolId])
}

model Event {
  id          String    @id @default(uuid())
  classId     String
  title       String
  description String?
  dayOfWeek   Int?
  startTime   String?
  endTime     String?
  date        DateTime?
  createdAt   DateTime  @default(now())
  teacherId   String
  class       Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher     Teacher   @relation("TeacherToEvent", fields: [teacherId], references: [id])
  schoolId    String
  
  // Relacionamentos
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model Assignment {
  id          String                 @id @default(uuid())
  classId     String
  description String
  dueDate     DateTime
  sentDate    DateTime               @default(now())
  fileUrl     String?
  createdAt   DateTime               @default(now())
  subjectId   String
  class       Class                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject                @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String     @id @default(uuid())
  assignmentId String
  studentId    String
  fileUrl      String?
  description  String?
  submittedAt  DateTime   @default(now())
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model StoredFile {
  id           String   @id @default(uuid())
  originalName String
  storedName   String
  mimeType     String
  size         Int
  category     String
  relativePath String   @unique
  publicUrl    String
  uploadedById String?
  createdAt    DateTime @default(now())

  @@map("stored_files")
}

enum Role {
  DEVELOPER
  ADMIN
  STUDENT
  TEACHER
}

enum Shift {
  MATUTINO
  VESPERTINO
  NOTURNO
  INTEGRAL
}

enum SubjectType {
  LINGUA_INGLESA
  ARTE
  EDUCACAO_FISICA
  MATEMATICA
  CIENCIAS
  HISTORIA
  GEOGRAFIA
  ENSINO_RELIGIOSO
  BIOLOGIA
  FISICA
  QUIMICA
  FILOSOFIA
  SOCIOLOGIA
  CONTEUDO_INTERDISCIPLINAR
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  JUSTIFIED_ABSENT
}
