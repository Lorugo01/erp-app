generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STUDENT
  TEACHER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role
  student   Student?
  teacher   Teacher?
  chatParticipants chatparticipant[]
  messages  message[]
  createdAt DateTime @default(now())
}

model Student {
  id                String        @id @default(uuid())
  userId            String?       @unique
  name              String
  email             String        @unique
  registrationNumber String?      @unique
  profilePicture    String?
  phone             String?
  address           String?
  birthDate         DateTime?
  enrollments       Enrollment[]
  attendances       Attendance[]
  grades            Grade[]
  createdAt         DateTime      @default(now())
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignmentSubmissions AssignmentSubmission[]
}


model chat {
  id           String           @id @default(uuid())
  title        String
  created_at   DateTime         @default(now())
  participants chatparticipant[]
  messages     message[]
}

model chatparticipant {
  id        String   @id @default(uuid())
  chat_id   String
  user_id   String

  chat      chat     @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model message {
  id         String   @id @default(uuid())
  chat_id    String
  user_id    String?
  content    String
  created_at DateTime @default(now())

  chat       chat     @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  files      File[]
}

model File {
  id          String   @id @default(uuid())
  message_id  String
  file_path   String
  file_name   String
  file_type   String
  uploaded_at DateTime @default(now())

  message     message  @relation(fields: [message_id], references: [id], onDelete: Cascade)
}

model Enrollment {
  id        String   @id @default(uuid())
  studentId String
  classId   String
  year      Int
  current   Boolean  @default(false)

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId, year])
}

enum Shift {
  MATUTINO
  VESPERTINO
  NOTURNO
}

model Class {
  id            String        @id @default(uuid())
  grade         Int
  letter        String        // ← novo campo (ex: A, B, C)
  academicYear  Int
  shift         Shift
  name          String
  evaluationModel String      // "NUMERIC", "CONCEPT", "HYBRID"

  enrollments   Enrollment[]
  subjects      Subject[]
  lessons       Lesson[]
  events        Event[]
  assignments   Assignment[]
}

model Teacher {
  id        String      @id @default(uuid())
  userId    String?     @unique
  name      String
  email     String      @unique
  subjects  Subject[]
  lessons   Lesson[]
  createdAt DateTime    @default(now())
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  events    Event[]     @relation("TeacherToEvent")
}

model Subject {
  id         String      @id @default(uuid())
  name       String
  type       SubjectType
  class      Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId    String
  teacher    Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId  String
  lessons    Lesson[]
  grades     Grade[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

enum SubjectType {
  LINGUA_INGLESA
  ARTE
  EDUCACAO_FISICA
  MATEMATICA
  CIENCIAS
  HISTORIA
  GEOGRAFIA
  ENSINO_RELIGIOSO
  BIOLOGIA
  FISICA
  QUIMICA
  FILOSOFIA
  SOCIOLOGIA
  CONTEUDO_INTERDISCIPLINAR
}

model Lesson {
  id        String      @id @default(uuid())
  date      DateTime
  subjectId String
  classId   String
  teacherId String
  subject   Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class     Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher   Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  attendances Attendance[]
}

model Attendance {
  id        String      @id @default(uuid())
  studentId String
  lessonId  String
  present   Boolean
  student   Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson    Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model GradePeriod {
  id     String  @id @default(uuid())
  name   String  // Ex: "1º Bimestre", "2º Trimestre"
  order  Int
  grades Grade[]
}

model GradeType {
  id          String   @id @default(uuid())
  name        String   // Ex: "Prova", "Trabalho", "Média Final", "Recuperação"
  description String?
  isConcept   Boolean  @default(false) // true se for conceito, false se for nota numérica
  grades      Grade[]
}

model Grade {
  id         String      @id @default(uuid())
  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId  String
  subject    Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId  String
  type       GradeType   @relation(fields: [typeId], references: [id], onDelete: Cascade)
  typeId     String
  period     GradePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  periodId   String
  value      Float?      // Para nota numérica
  concept    String?     // Para conceito (MB, B, R, I, etc)
  date       DateTime    @default(now())
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Config {
  id                Int     @id @default(1)
  evaluationModel   String  // "NUMERIC", "CONCEPT", "HYBRID"
  minGrade          Float   @default(5.0)
  minAttendance     Float   @default(75.0) // porcentagem
}

model Event {
  id          String   @id @default(uuid())
  classId     String
  teacherId   String
  title       String
  description String?
  dayOfWeek   Int?      //
  startTime   String?   // "08:00"
  endTime     String?   // "09:00"
  date        DateTime? // Opcional: para eventos únicos
  createdAt   DateTime @default(now())

  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher     Teacher  @relation("TeacherToEvent", fields: [teacherId], references: [id])
}

// Adicionar modelos para atividades e entregas dos alunos

model Assignment {
  id          String   @id @default(uuid())
  classId     String
  description String
  dueDate     DateTime
  sentDate    DateTime @default(now())
  fileUrl     String?
  createdAt   DateTime @default(now())

  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String   @id @default(uuid())
  assignmentId String
  studentId    String
  fileUrl      String?
  description  String?
  submittedAt  DateTime @default(now())

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
}