# =============================================================================
# ByLAB ERP — variáveis unificadas (raiz do projeto: erp-app/.env)
# Copie: cp .env.example .env
# Flutter: .\scripts\sync-env.ps1  (copia → erp/.env)
# Docker VPS: só db + api usam este arquivo na raiz
# =============================================================================

# --- Flutter (mobile / web local) ---
ENVIRONMENT=local
API_BASE_URL=http://localhost:3150
UPLOADS_BASE_URL=http://localhost:3150
TECAAI_BASE_URL=http://localhost:5010
TECAAI_PATH_PREFIX=
API_REQUEST_TIMEOUT=30
TECAAI_REQUEST_TIMEOUT=30
MAX_FILE_SIZE=10485760
ENABLE_HTTPS=false
DEBUG_MODE=true
LOG_LEVEL=verbose
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false

# --- API (desenvolvimento local ou Docker) ---
DATABASE_URL=postgresql://postgres:senha@localhost:5432/bylab_db
JWT_SECRET=altere-esta-chave-secreta
PORT=3000
HTTP_PORT=3000
HOST=0.0.0.0
RUN_SEED=true
CORS_ORIGIN=*

# --- Docker VPS (db + api) ---
POSTGRES_USER=bylab
POSTGRES_PASSWORD=bylab_secret_change_me
POSTGRES_DB=bylab_db
API_PORT=3150
API_BIND=127.0.0.1

# --- Produção Luditeca (mobile) ---
# API_BASE_URL=https://bylab-api.luditeca.com
# UPLOADS_BASE_URL=https://bylab-api.luditeca.com
# TECAAI_BASE_URL=https://ia.luditeca.com
# TECAAI_PATH_PREFIX=/bylab
# ENABLE_HTTPS=true
# Ver: deploy/DEPLOY-LUDITECA.md
