# =============================================================================
# ByLAB ERP — variáveis unificadas (raiz do projeto: erp-app/.env)
# Copie: cp .env.example .env
# =============================================================================

# --- Flutter / App Web ---
ENVIRONMENT=local
API_BASE_URL=http://localhost:3000
TECAAI_BASE_URL=http://localhost:5001
UPLOADS_BASE_URL=http://localhost:3000
API_REQUEST_TIMEOUT=30
TECAAI_REQUEST_TIMEOUT=30
MAX_FILE_SIZE=10485760
ENABLE_HTTPS=false
ENABLE_CORS=true
DEBUG_MODE=true
LOG_LEVEL=verbose
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false

# --- API (desenvolvimento local) ---
DATABASE_URL=postgresql://postgres:senha@localhost:5432/bylab_db
JWT_SECRET=altere-esta-chave-secreta
PORT=3000
HTTP_PORT=3000
HOST=0.0.0.0
RUN_SEED=true
CORS_ORIGIN=*

# --- Docker / VPS ---
POSTGRES_USER=bylab
POSTGRES_PASSWORD=bylab_secret_change_me
POSTGRES_DB=bylab_db
API_PORT=3000
WEB_PORT=8080

# VPS — troque localhost pelo IP ou domínio público:
# ENVIRONMENT=production
# API_BASE_URL=http://203.0.113.10:3000
# TECAAI_BASE_URL=http://203.0.113.10:5001
# UPLOADS_BASE_URL=http://203.0.113.10:3000
