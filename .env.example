# =============================================================================
# ByLAB ERP — variáveis unificadas (raiz do projeto: erp-app/.env)
# Copie: cp .env.example .env
# =============================================================================

# --- Flutter / App Web ---
ENVIRONMENT=local
API_BASE_URL=http://localhost:3040
TECAAI_BASE_URL=http://localhost:5001
UPLOADS_BASE_URL=http://localhost:3040
API_REQUEST_TIMEOUT=30
TECAAI_REQUEST_TIMEOUT=30
MAX_FILE_SIZE=10485760
ENABLE_HTTPS=false
ENABLE_CORS=true
DEBUG_MODE=true
LOG_LEVEL=verbose
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false

# --- API (desenvolvimento local) ---
DATABASE_URL=postgresql://postgres:senha@localhost:5432/bylab_db
JWT_SECRET=altere-esta-chave-secreta
PORT=3000
HTTP_PORT=3000
HOST=0.0.0.0
RUN_SEED=true
CORS_ORIGIN=*

# --- Docker / VPS ---
POSTGRES_USER=bylab
POSTGRES_PASSWORD=bylab_secret_change_me
POSTGRES_DB=bylab_db
API_PORT=3040
WEB_PORT=9050
WEB_BIND=127.0.0.1
API_BIND=127.0.0.1
CONFIG_HASH=default

# --- Produção Luditeca (erp.luditeca.com) ---
# DNS Hostinger: A erp → IP VPS | A api → IP VPS
# ENVIRONMENT=production
# API_BASE_URL=https://api.luditeca.com
# UPLOADS_BASE_URL=https://api.luditeca.com
# CORS_ORIGIN=https://erp.luditeca.com
# ENABLE_HTTPS=true
# CONFIG_HASH=luditeca-v1
# Ver: deploy/DEPLOY-LUDITECA.md
