VPS_IP=

# --- API — desenvolvimento local (npm run dev) ---
DATABASE_URL=postgresql://postgres:senha@localhost:5432/bylab_db
JWT_SECRET=altere-esta-chave-secreta-em-producao
PORT=3000
HTTP_PORT=3000
HOST=0.0.0.0
RUN_SEED=true
CORS_ORIGIN=*

# --- Storage de arquivos ---
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=10

# --- Docker VPS (db + api) ---
# PORT/HTTP_PORT = 3000 no container | API_PORT = porta no host (IP público)
POSTGRES_USER=bylab
POSTGRES_PASSWORD=bylab_secret_change_me
POSTGRES_DB=bylab_db
API_PORT=3150
API_BIND=0.0.0.0

# --- Produção VPS (Docker) — descomente e ajuste senhas ---
# DATABASE_URL=postgresql://bylab:SENHA@db:5432/bylab_db?schema=public
# JWT_SECRET=chave-longa-gerada-com-openssl-rand-base64-48
