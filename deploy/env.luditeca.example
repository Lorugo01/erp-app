# Produção Luditeca — erp.luditeca.com
# Copie estas linhas para erp-app/.env na VPS e ajuste senhas

ENVIRONMENT=production

# URLs públicas (HTTPS após certbot)
API_BASE_URL=https://api.luditeca.com
UPLOADS_BASE_URL=https://api.luditeca.com
TECAAI_BASE_URL=http://187.127.0.245:5001

ENABLE_HTTPS=true
ENABLE_CORS=true
CORS_ORIGIN=https://erp.luditeca.com
DEBUG_MODE=false
LOG_LEVEL=error

# Docker — containers só em localhost (Nginx do host expõe o domínio)
WEB_PORT=9050
API_PORT=3040
WEB_BIND=127.0.0.1
API_BIND=127.0.0.1

# Força rebuild do Flutter Web quando URLs mudarem
CONFIG_HASH=luditeca-v1

POSTGRES_USER=bylab
POSTGRES_PASSWORD=ALTERE_SENHA_FORTE
POSTGRES_DB=bylab_db
JWT_SECRET=ALTERE_JWT_FORTE
RUN_SEED=true

DATABASE_URL=postgresql://bylab:ALTERE@db:5432/bylab_db
PORT=3000
HTTP_PORT=3000
HOST=0.0.0.0
