# Produção Luditeca — VPS (só Docker: db + api)
# App mobile: edite erp-app/.env local → .\scripts\sync-env.ps1 → build Flutter
#
# DNS: bylab-api → IP VPS | ia → IP VPS (TecaAI)
# api.luditeca.com = luditeca-vps (outra app — não usar para ByLAB)

ENVIRONMENT=production

# URLs no app Flutter (mobile) — copie para seu .env local
API_BASE_URL=https://bylab-api.luditeca.com
UPLOADS_BASE_URL=https://bylab-api.luditeca.com
TECAAI_BASE_URL=https://ia.luditeca.com
TECAAI_PATH_PREFIX=/bylab
ENABLE_HTTPS=true

# --- API Docker (VPS) ---
CORS_ORIGIN=*
POSTGRES_USER=bylab
POSTGRES_PASSWORD=ALTERE_SENHA_FORTE
POSTGRES_DB=bylab_db
JWT_SECRET=ALTERE_JWT_FORTE
RUN_SEED=true
DATABASE_URL=postgresql://bylab:ALTERE@db:5432/bylab_db?schema=public
PORT=3000
HTTP_PORT=3000
HOST=0.0.0.0
API_PORT=3150
API_BIND=127.0.0.1
TECAAI_PORT=5010
